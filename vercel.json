{
  "rewrites": [
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/legal",
      "destination": "/legal/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/support",
      "destination": "/support/index.html"
    },
    {
      "source": "/delete-account",
      "destination": "/delete-account/index.html"
    },
    {
      "source": "/community-guidelines",
      "destination": "/community-guidelines/index.html"
    },
    {
      "source": "/en",
      "destination": "/en/index.html"
    },
    {
      "source": "/en/contact",
      "destination": "/en/contact/index.html"
    },
    {
      "source": "/en/legal",
      "destination": "/en/legal/index.html"
    },
    {
      "source": "/en/terms",
      "destination": "/en/terms/index.html"
    },
    {
      "source": "/en/privacy",
      "destination": "/en/privacy/index.html"
    },
    {
      "source": "/en/support",
      "destination": "/en/support/index.html"
    },
    {
      "source": "/en/delete-account",
      "destination": "/en/delete-account/index.html"
    },
    {
      "source": "/en/community-guidelines",
      "destination": "/en/community-guidelines/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/:file(sitemap.xml|robots.txt|llms.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/:file(favicon.ico|pocha-favicon.png|apple-touch-icon.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/app",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/extension",
      "destination": "https://chromewebstore.google.com/detail/fcaefgilphmnhhbjjeailgnklfnhcmpc",
      "permanent": true
    },
    {
      "source": "/concept",
      "destination": "/#methode",
      "permanent": true
    },
    {
      "source": "/features/pomodoro-timer",
      "destination": "/#minuteur",
      "permanent": true
    },
    {
      "source": "/features/statistics",
      "destination": "/#statistiques",
      "permanent": true
    },
    {
      "source": "/features/rewards-system",
      "destination": "/#recompenses",
      "permanent": true
    },
    {
      "source": "/use-cases/students",
      "destination": "/#etudes",
      "permanent": true
    },
    {
      "source": "/blog/meilleur-pomodoro-en-ligne-2026",
      "destination": "https://www.pomocha.io/",
      "permanent": true
    },
    {
      "source": "/pomocha-og.png",
      "destination": "/assets/pocha/pocha-minuteur-pomodoro.jpg",
      "permanent": true
    },
    {
      "source": "/break-ic.svg",
      "destination": "/pocha-favicon.png",
      "permanent": true
    },
    {
      "source": "/assets/pocha/app-store/icon.webp",
      "destination": "/pocha-favicon.png",
      "permanent": true
    }
  ]
}
